    {
      "id": "Y6NWK4rpB4TMTJ96KV_zE",
      "type": "text",
      "x": 165,
      "y": 478.5,
      "width": 1243,
      "height": 200,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8z",
      "roundness": null,
      "seed": 754236037,
      "version": 487,
      "versionNonce": 598672340,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1784377067407,
      "link": null,
      "locked": false,
      "text": "snowFlakeID -> 64bits\n\n1 bits(signed bit) + 41 bits(timeStamps) + 10 bits(workId from Zookeper) + 12 bits(random num from local counter)\n- the entire unique id is generated locally that removes external redis call for counter & reduce latency\n\nNote - Zookeper never fails it should not be single point of failure once server got register it generates workId\n\n ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "snowFlakeID -> 64bits\n\n1 bits(signed bit) + 41 bits(timeStamps) + 10 bits(workId from Zookeper) + 12 bits(random num from local counter)\n- the entire unique id is generated locally that removes external redis call for counter & reduce latency\n\nNote - Zookeper never fails it should not be single point of failure once server got register it generates workId\n\n ",
      "autoResize": true,
      "lineHeight": 1.25
    },
