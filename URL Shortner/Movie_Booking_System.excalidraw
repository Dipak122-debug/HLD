    {
      "id": "P9LQEc6YxN0eITBItdLg4",
      "type": "text",
      "x": 353.2580275837332,
      "y": -3983.376685119262,
      "width": 730.3989868164062,
      "height": 360,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9J",
