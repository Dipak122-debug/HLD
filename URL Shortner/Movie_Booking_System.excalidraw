      "link": null,
      "locked": false,
      "text": "\n\nUser 1 & user2 try to book\nsame seat user 1 lock the seat first A22\n at the same time suppose after 30sec if\nuser2 tries to book the same seat,it can not happen \nbecause A22 is already in redis to user2 checks redis first\nif the seat is there, he wont be able to book the seat ",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\nUser 1 & user2 try to book\nsame seat user 1 lock the seat first A22\n at the same time suppose after 30sec if\nuser2 tries to book the same seat,it can not happen \nbecause A22 is already in redis to user2 checks redis first\nif the seat is there, he wont be able to book the seat ",
      "autoResize": true,
      "lineHeight": 1.25
    },
