    {
      "id": "Fj2kAqf-mjttWmcAbgjgF",
      "type": "text",
      "x": 678,
      "y": -177.5,
      "width": 913,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
